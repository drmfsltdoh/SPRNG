# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
PORT=3001

# REQUIRED — signs/verifies login sessions (JWTs). Generate a long random
# string, e.g. `openssl rand -hex 32`, and never reuse it across environments.
JWT_SECRET=

# One-time bootstrap key for creating your first admin account. To create an
# admin, POST to /api/signup with role: "admin" and adminKey set to this
# value (via curl/Postman — there's no admin signup screen in the app on
# purpose). Once you have the admin accounts you need, you can blank this
# out or rotate it so no one else can mint new admins.
ADMIN_SIGNUP_KEY=

# Server-side Google key used ONLY by this backend to call the Places API
# (autocomplete/details/nearby) on behalf of the app. This must be a
# DIFFERENT key from the one in mobile/app.json — that one is restricted to
# the Android app's package name + SHA-1 fingerprint (correct, for Maps SDK
# use), which is exactly why it silently fails when called as a raw HTTP
# request from JS. Create a separate key in Google Cloud Console, restrict
# it by IP address (your server's IP) or leave it unrestricted with a strict
# billing quota, and enable "Places API" for it.
GOOGLE_PLACES_API_KEY=

# Optional — powers route-deviation protection (comparing a trip's actual
# driven distance against Google's "optimal" route to cap fares after a
# detour). Reuses GOOGLE_PLACES_API_KEY above by default as long as
# "Routes API" is ALSO enabled for that key in Cloud Console. Only set
# this if you want a separate key/quota dedicated to routing calls.
GOOGLE_ROUTES_API_KEY=
